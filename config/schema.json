{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlee821/finemapping/config/schema.json",
  "title": "GWASfinemapping run configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "gwas",
    "regions",
    "ld",
    "sample_size",
    "methods",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "genome_build", "output_dir"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "genome_build": {
          "const": "GRCh38"
        },
        "output_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gwas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trait", "ancestry", "vcf"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trait": {
          "type": "string",
          "minLength": 1
        },
        "ancestry": {
          "type": "string",
          "minLength": 1
        },
        "vcf": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["genome_wide", "gene_regions", "explicit"]
        },
        "significance_threshold": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "merge_distance_bp": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "extension_bp": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "gene_annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version", "genome_build"],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "genome_build": {
              "const": "GRCh38"
            }
          }
        },
        "cis_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "upstream_bp", "downstream_bp"],
          "properties": {
            "strategy": {
              "const": "gene_body_extension"
            },
            "upstream_bp": {
              "type": "integer",
              "minimum": 0
            },
            "downstream_bp": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "intervals": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "genome_wide"
              }
            }
          },
          "then": {
            "required": [
              "significance_threshold",
              "merge_distance_bp",
              "extension_bp"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "gene_regions"
              }
            }
          },
          "then": {
            "required": ["gene_annotation", "cis_window"]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "explicit"
              }
            }
          },
          "then": {
            "required": ["intervals"]
          }
        }
      ]
    },
    "ld": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "release", "population", "variant_index"],
      "properties": {
        "reference": {
          "const": "panukb"
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "enum": ["AFR", "AMR", "CSA", "EAS", "EUR", "MID"]
        },
        "reference_sample_size": {
          "type": ["number", "null"],
          "minimum": 3
        },
        "variant_index": {
          "type": "string",
          "minLength": 1
        },
        "matrix_repair": {
          "enum": ["error", "regularize", "nearest_psd"]
        }
      }
    },
    "sample_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimator", "effective_n_override"],
      "properties": {
        "estimator": {
          "const": "minimum_variant_ss"
        },
        "effective_n_override": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "const": "p_value"
              },
              "top_n": {
                "type": ["integer", "null"],
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "r2_thresholds"],
            "properties": {
              "id": {
                "const": "p_ld"
              },
              "r2_thresholds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "L", "coverage", "min_abs_corr"],
            "properties": {
              "id": {
                "const": "susie_rss"
              },
              "L": {
                "type": "integer",
                "minimum": 1
              },
              "coverage": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "min_abs_corr": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "L",
              "coverage",
              "min_abs_corr",
              "R_finite",
              "R_mismatch"
            ],
            "properties": {
              "id": {
                "const": "susie_rrss"
              },
              "L": {
                "type": "integer",
                "minimum": 1
              },
              "coverage": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "min_abs_corr": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "R_finite": {
                "const": "ld_reference_sample_size"
              },
              "R_mismatch": {
                "enum": ["none", "eb", "eb_mix"]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "enum": ["carma", "polyfun_susie"]
              }
            }
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "memory", "time"],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?\\s*(B|KB|MB|GB|TB)$"
        },
        "time": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?\\s*(s|m|h|d)$"
        }
      }
    }
  },
  "allOf": [
      {
        "if": {
          "properties": {
            "methods": {
              "contains": {
                "properties": {
                  "id": {
                    "const": "susie_rrss"
                  }
                },
                "required": ["id"]
              }
            }
          },
          "required": ["methods"]
        },
        "then": {
          "properties": {
            "ld": {
              "required": ["reference_sample_size"],
              "properties": {
                "reference_sample_size": {
                  "type": "number",
                  "minimum": 3
                }
              }
            }
          }
        }
      }
  ]
}
