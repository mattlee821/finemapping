// Container runtime configuration (Apptainer on HPC / Docker locally)
def containerImg = params.container_image ?:
    System.getenv('GWASFM_CONTAINER_IMAGE') ?:
    System.getenv('GWASFM_CONTAINER_REF') ?:
    'ghcr.io/mattlee821/finemapping:latest'

def refRoot = params.panukb_dir ?
    new File(params.panukb_dir).parent :
    (System.getenv('GWASFM_REFERENCE_ROOT') ?: "${System.properties['user.home']}/.cache/gwasfinemapping/reference")

def cacheRoot = params.cache_dir ?:
    (System.getenv('GWASFM_CACHE_DIR') ?: "${System.properties['user.home']}/.cache/gwasfinemapping")

def extraDirs = [refRoot, cacheRoot, params.outdir, params.input_dir]
    .findAll { it != null && it.toString().trim() != '' }
    .collect { new File(it.toString()).canonicalPath }
    .unique()

process.container = containerImg

if (params.container_engine == 'docker') {
    docker {
        enabled = true
        runOptions = extraDirs.collect { "-v '${it}:${it}'" }.join(' ')
    }
} else {
    apptainer {
        enabled = true
        autoMounts = true
        runOptions = extraDirs.collect { "--bind '${it}:${it}'" }.join(' ')
    }
}
