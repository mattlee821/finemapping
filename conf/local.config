process {
    executor = 'local'
    maxForks = params.max_forks
    cpus = 2
    memory = '8 GB'
    time = '24h'

    withName: 'SCREEN_GWAS' {
        maxForks = 1
    }
    withLabel: 'method_heavy' {
        maxForks = 1
        cpus = 2
        memory = '6 GB'
        time = '24h'
    }
}

executor {
    queueSize = 8
}
