process {
    executor = 'slurm'
    maxForks = params.max_forks
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2
    cpus = 2
    time = { 12.h * task.attempt }
    clusterOptions = {
        def opts = []
        if (params.slurm_partition) opts << "--partition=${params.slurm_partition}"
        if (params.slurm_account) opts << "--account=${params.slurm_account}"
        opts.join(' ')
    }

    withName: 'PREPARE_MANIFEST|UPDATE_STATE' {
        executor = 'local'
    }
    withName: 'SCREEN_GWAS' {
        maxForks = Math.max(1, Math.min(8, ((params.max_forks ?: 2) as Integer).intdiv(4)))
        cpus = 2
        memory = '6 GB'
        time = '2h'
    }
    withName: 'FINALISE_GWAS' {
        maxForks = Math.max(2, Math.min(16, ((params.max_forks ?: 2) as Integer).intdiv(2)))
        cpus = 2
        memory = '6 GB'
        time = '2h'
    }
    withLabel: 'method_heavy' {
        maxForks = (params.max_forks ?: 2) as Integer
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries = 2
        cpus = 2
        time = { 8.h * task.attempt }
    }
}

executor {
    name = 'slurm'
    queueSize = ((params.max_forks ?: 2) as Integer) + 24
    submitRateLimit = '5/1sec'
}
