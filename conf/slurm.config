process {
    executor = 'slurm'
    maxForks = params.max_forks
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2
    cpus = 2
    memory = { 16.GB * task.attempt }
    time = { 12.h * task.attempt }
    clusterOptions = {
        def opts = []
        if (params.slurm_partition) opts << "--partition=${params.slurm_partition}"
        if (params.slurm_account) opts << "--account=${params.slurm_account}"
        opts.join(' ')
    }

    withName: 'PREPARE_MANIFEST|UPDATE_STATE|SCREEN_GWAS|FINALISE_GWAS' {
        cpus = 2
        memory = '6 GB'
        time = '2h'
    }
    withName: 'CLEAN_LOCUS_SCRATCH' {
        executor = 'local'
    }
    withLabel: 'stage_prep' {
        cpus = 2
        memory = { 12.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withLabel: 'method_light' {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withLabel: 'method_heavy' {
        cpus = 2
        memory = { 16.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
}

executor {
    name = 'slurm'
    queueSize = params.max_forks
    submitRateLimit = '10 sec'
}
