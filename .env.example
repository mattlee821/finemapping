# Local tools live outside cloud-synced folders by default. Set an override if needed.
GWASFM_TOOLS_ROOT=

# Optional: pull and use the published container with --container docker|apptainer.
GWASFM_CONTAINER=
GWASFM_CONTAINER_REF=ghcr.io/mattlee821/finemapping:latest

# Reference data (Pan-UKB variant indexes, GRCh37 FASTA, liftover chain, gene annotation), installed by
# scripts/install_reference_data.sh. Empty = ~/.cache/gwasfinemapping/reference, outside cloud-synced folders.
GWASFM_REFERENCE_ROOT=
