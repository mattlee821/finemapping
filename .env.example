# Default output directory (<GWASFM_WORK_ROOT>/<STUDYID>/<GWASID>/ and .../logs/).
# Empty = <repo>/finemapping (or ~/GWASfinemapping-data/finemapping when inside cloud sync).
GWASFM_WORK_ROOT=

# Optional scratch/temp root for Nextflow workdirs, run logs, Pan-UKB bm_cache, and TMPDIR
# (e.g. /scratch/<user>/GWASfinemapping); installed tools & reference data stay under GWASFM_TOOLS_ROOT.
GWASFM_TEMP_ROOT=
GWASFM_BM_CACHE_DIR=

# Local tools, Nextflow workdir, and caches live outside cloud-synced folders by default.
GWASFM_TOOLS_ROOT=
GWASFM_CACHE_DIR=
GWASFM_NXF_WORK=

# Reference data installed once by `bash scripts/install_reference_data.sh install`
# (GRCh38->GRCh37 chain, GRCh37 FASTA + .fai, GRCh38 gene coordinates, 6 Pan-UKB indexes, PolyFun UKB priors).
# Empty = ~/.cache/gwasfinemapping/reference
GWASFM_REFERENCE_ROOT=

# Optional container settings (`docker` or `apptainer`, matching GWASprocessing).
GWASFM_CONTAINER=
GWASFM_CONTAINER_REF=ghcr.io/mattlee821/finemapping:latest
GWASFM_CONTAINER_IMAGE=

# Optional SLURM defaults for `scripts/finemap.sh --slurm`
GWASFM_SLURM_PARTITION=
GWASFM_SLURM_ACCOUNT=
GWASFM_MAX_FORKS=4
