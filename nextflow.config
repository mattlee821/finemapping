manifest {
    name = 'GWASfinemapping'
    description = 'Scalable statistical fine-mapping of standardised GRCh38 GWAS-VCFs against Pan-UKB LD'
    nextflowVersion = '>=23.10.0'
}

params {
    // Input selection (one of input_dir, manifest, or vcf)
    input_dir = null
    manifest = null
    vcf = null
    vcf_index = null
    metadata = null
    qc = null
    study_id = null
    gwas_id = null
    trait = null
    ancestry = null
    gene_id = null
    only_study = null

    // Reference data paths (auto-resolved from GWASFM_REFERENCE_ROOT by scripts/finemap.sh)
    chain = null
    grch37_fasta = null
    grch37_fai = null
    gene_annotation = null
    panukb_dir = null
    polyfun_dir = null
    local_ld_panel = null
    bm_path = null

    // Output, logs, and caching
    outdir = null
    log_root = null
    work_dir = null
    scratch_dir = System.getenv('GWASFM_SCRATCH_DIR') ?: null
    temp_dir = System.getenv('GWASFM_TMP_DIR') ?: null
    bm_cache_dir = System.getenv('GWASFM_BM_CACHE_DIR') ?: null
    cache_dir = System.getenv('GWASFM_CACHE_DIR') ?: "${System.properties['user.home']}/.cache/gwasfinemapping"

    // Method & region defaults (Phase A approved specifications)
    methods = 'p_ld,susie_rss,susie_rrss,carma,polyfun'
    output_format = 'rda'
    compress = 'xz'
    population = 'EUR'
    reference_sample_size = null
    effective_n = null
    significance_lp = 7.301029995664
    cis_significance_lp = null
    region_flank_bp = 1500000
    max_region_width_bp = 9500000
    merge_distance_bp = 250000
    gene_window_bp = 1000000
    exclude_mhc = false
    max_loci = 0
    max_causal = 10
    max_iter = 50

    // Batch control & reporting (matching GWASprocessing)
    row_limit = 0
    force = false
    dry_run = false
    report = true
    keep_intermediates = false
    allow_ancestry_mismatch = false

    // Execution & container options
    max_forks = (System.getenv('GWASFM_MAX_FORKS') ?: '2') as Integer
    slurm_partition = System.getenv('GWASFM_SLURM_PARTITION') ?: null
    slurm_account = System.getenv('GWASFM_SLURM_ACCOUNT') ?: null
    container_engine = 'apptainer'
    container_image = null
}

workDir = params.work_dir ?:
    System.getenv('GWASFM_NXF_WORK') ?:
    "${System.properties['user.home']}/.cache/gwasfinemapping/nextflow-work"

process {
    executor = 'local'
    stageInMode = 'symlink'
    errorStrategy = 'finish'
}

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    container {
        includeConfig 'conf/container.config'
    }
    docker {
        params.container_engine = 'docker'
        includeConfig 'conf/container.config'
    }
    apptainer {
        params.container_engine = 'apptainer'
        includeConfig 'conf/container.config'
    }
}
