manifest.nextflowVersion = '>=23.10.0'

params.input_dir = null
params.max_inputs = 10
params.max_forks = 2
params.outdir = null
params.work_dir = null
params.cache_dir = "${System.properties['user.home']}/.cache/gwasfinemapping"
params.population = 'EUR'
params.reference_sample_size = null
params.significance_lp = 7.301029995664
params.merge_distance_bp = 250000
params.region_flank_bp = 100000
params.gene_window_bp = 1000000
params.max_loci = 0
params.vcf = null
params.vcf_index = null
params.metadata = null
params.qc = null
params.chain = null
params.grch37_fasta = null
params.grch37_fai = null
params.gene_annotation = null
params.study_id = null
params.gwas_id = null

workDir = params.work_dir ?:
    System.getenv('GWASFM_NXF_WORK') ?:
    "${System.properties['user.home']}/.cache/gwasfinemapping/nextflow-work"

process {
    executor = 'local'
    maxForks = params.max_forks
    stageInMode = 'symlink'
    errorStrategy = 'terminate'
}

executor {
    queueSize = params.max_forks
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
}
